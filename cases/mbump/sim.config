[Simulation]
# Simulation settings.
mode = 2
# Simulation mode.
# 0 for thermal, 1 for mechanical, 2 for couple.

interp_num = 6
# Number of interpolation points along one direction.

model_dir = ./model
# Path for reduced-order models

result_dir = ./mor
# Path for simulation results

[MeshConfig]
# Offline Mesh configuration settings.
# Can be overrided by settings in the xml file
mesh_size = 2.0e-6
# Maximum size of the mesh (unit: m).
# Recommended value: 1e-7 to 1e-5, depending on the lateral dimension.

unit = 6
# Scale dimensions inside the simulator by 10^{unit}.

precision = 9
# Round dimensions inside the simulator to (precision-unit) decimal places.

[SolverConfig]
# Online Solver configuration settings.
solver_type = 0
# Type of solver.
# 0 for iterative solver (smoothed aggregation algebraic multigrid solver),
# 1 for direct solver (lu decomposition with mumps as factor matrix solver).

rtol = 1e-6
# Relative tolerance of residue.
# Invalid for the direct solver.

# atol = 1e-8
# Absolute tolerance of residue.
# Invalid for the direct solver.

max_it = 500
# Maximum number of iteration.
# Invalid for the direct solver.

is_display = True
# Whether to show iteration details or not.

[Temperature]
# Temperature settings.
reference = 423.15
# Reference temperature for the mechanical simulation (unit: K).

ambient = 298.15
# Ambient temperature for the mechanical simulation (unit: K).

[Structure]
# Structure settings
path = ./mbump.xml
# Paths for xml files

default = mbump
# Default structure if floorplan file is not complete

[Floorplan]
# Floorplan settings
path = ./flp.json
# Path for floorplan

[Boundary]
# Boundary condition settings
origin =
# XYZ Origins of the array

temp_path =
# Path for temperature values

disp_path =
# Path for displacement values

[Matlib]
# Material settings
path = ./material.config
# Path of the material library

[Postprocess]
# Postprocessing settings
value = temp, h_flux, disp, stress
reso = 50
z_coord = 15e-6

[Solid]
# Solid domain settings
properties = thermal expansion coefficient (1/K), young modulus (N/m2), poisson ratio (1), thermal conductivity (W/m-K)
# Material properties that must be included in the material library.